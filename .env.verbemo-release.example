# Copy to .env.verbemo-release (ignored), fill in your own values, then explicitly:
# set -a; source .env.verbemo-release; set +a
# Neither make app nor the release builder reads this file automatically.
# Developer ID/notarization await your Apple Developer Program membership.
VERBEMO_SIGN_ID="Developer ID Application: YOUR NAME (YOURTEAMID)"
VERBEMO_SPARKLE_PUBLIC_KEY=""
# Export your own Sparkle key to a private file outside the repository.
VERBEMO_SPARKLE_PRIVATE_KEY_FILE="/absolute/private/path/verbemo-sparkle.key"
VERBEMO_NOTARY_KEY_FILE="/absolute/private/path/AuthKey.p8"
VERBEMO_NOTARY_KEY_ID=""
VERBEMO_NOTARY_ISSUER_ID=""
# Local development: make app SIGN_ID=- (no key => updater disabled).
# Signed assets only (does not publish):
# scripts/build-macos-release.sh --version "$(cat VERSION)" \
#   --source-commit "$(git rev-parse HEAD)" --output dist/macos
