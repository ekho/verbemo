<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <None Include="../../../Tests/Fixtures/MCP/*.json" Link="Fixtures/MCP/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <ProjectReference Include="../../src/Verbemo.Core/Verbemo.Core.csproj" />
    <Compile Include="../../src/Verbemo.App/ModelManager.cs" Link="ModelManager.cs" />
    <Compile Include="../../src/Verbemo.App/CommandLineToolLocator.cs" Link="CommandLineToolLocator.cs" />
  </ItemGroup>
</Project>
